      "khoa": false,
      "noi_dung": {
        "logline": "Một học viên nhìn lại 3 năm tập Inside Flow cùng Ari — từ buổi đầu run rẩy đến ngày nhận món quà Legacy.",
        "cot_truyen": "Phim cảm ơn 30 học viên gắn bó từ 3 năm trở lên. Mở đầu bằng tấm thảm cũ, hồi tưởng những buổi tập đầu tiên, những lần ngã, những lần đứng vững; kết bằng khoảnh khắc chim bồ câu mang quà Legacy đến.",
        "the_loai": "video-yoga-wellness",
        "thong_diep": "Sự kiên trì của bạn là di sản.",
        "doi_tuong": "Học viên Ari Yoga và người đang cân nhắc bắt đầu tập",
        "thoi_luong_giay": 60,
        "ti_le_khung": "9:16",
        "nen_tang": "Facebook Reels, TikTok",
        "phuong_an": [
          {
            "tieu_de": "Tấm thảm kể chuyện",
            "mo_ta": "Tấm thảm tập cũ là người kể chuyện (VO), chứng kiến 3 năm của học viên. Kết bằng tấm thảm mới được trao cùng quà Legacy.",
            "chon": true
          },
          {
            "tieu_de": "Hai mốc thời gian song song",
            "mo_ta": "Cắt xen buổi tập đầu tiên (run rẩy) và hôm nay (vững vàng) cùng một tư thế, hai hình khớp nhau qua match cut.",
            "chon": false
