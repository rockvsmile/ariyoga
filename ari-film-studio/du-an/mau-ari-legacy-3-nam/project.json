          {
            "tieu_de": "Lá thư của cô Ari",
            "mo_ta": "Giọng cô Ari đọc lá thư cảm ơn, hình ảnh là những khoảnh khắc nhỏ của lớp học qua 3 mùa.",
            "chon": false
          }
